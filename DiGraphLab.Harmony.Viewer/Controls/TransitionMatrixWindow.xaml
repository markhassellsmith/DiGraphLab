<Window x:Class="DiGraphLab.Harmony.Viewer.Controls.TransitionMatrixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transition Matrix" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="6" Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="SortCombo" Width="160" VerticalAlignment="Center" SelectionChanged="SortCombo_SelectionChanged">
                <ComboBoxItem Tag="default">Default</ComboBoxItem>
                <ComboBoxItem Tag="frequency">By Frequency</ComboBoxItem>
                <ComboBoxItem Tag="outdegree">By OutDegree</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="12,0,6,0" />
            <Slider x:Name="ZoomSlider" Minimum="50" Maximum="200" Value="100" Width="140" ValueChanged="ZoomSlider_ValueChanged" />
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Legend:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Border Width="120" Height="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#BBAAFF" Offset="0.5" />
                            <GradientStop Color="#4455FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text=" 0 → 1" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <Viewbox Stretch="None" x:Name="MatrixViewbox">
                <ItemsControl x:Name="MatrixGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Viewbox>
        </ScrollViewer>
    </Grid>
</Window>
