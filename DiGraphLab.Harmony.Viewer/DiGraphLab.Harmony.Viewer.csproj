<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows</TargetFramework>
	<UseWPF>true</UseWPF>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\DiGraphLab.Harmony\DiGraphLab.Harmony.csproj" />
  </ItemGroup>

  <ItemGroup>
	<!-- Removed WebView2 to produce a standalone WPF viewer with no external runtime dependencies -->
  </ItemGroup>

  <ItemGroup>
	<Content Include="viewer.html">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
  </ItemGroup>

</Project>
