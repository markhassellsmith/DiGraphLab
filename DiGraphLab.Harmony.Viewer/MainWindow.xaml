<Window x:Class="DiGraphLab.Harmony.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:WebView2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DiGraphLab Harmony Viewer" Height="720" Width="1024">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
            <Button x:Name="LoadDemoButton" Content="Load Demo" Width="100" Margin="4" Click="LoadDemoButton_Click" />
            <TextBlock VerticalAlignment="Center" Margin="8,0">Demo output folder will be created on your Desktop.</TextBlock>
        </StackPanel>
        <Grid>
            <WebView2:WebView2 x:Name="WebView" />
        </Grid>
    </DockPanel>
</Window>
