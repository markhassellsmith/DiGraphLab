<Window x:Class="DiGraphLab.Harmony.Viewer.EditNodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Node" Height="360" Width="420">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ID:" />
            <TextBlock x:Name="IdText" FontWeight="Bold" />
            <TextBlock Text="Traditional Label:" Margin="0,8,0,0" />
            <TextBox x:Name="TraditionalText" />
            <TextBlock Text="Nashville Label:" Margin="0,8,0,0" />
            <TextBox x:Name="NashvilleText" />
            <TextBlock Text="Root PC (0-11):" Margin="0,8,0,0" />
            <TextBox x:Name="RootText" />
            <TextBlock Text="Quality:" Margin="0,8,0,0" />
            <TextBox x:Name="QualityText" />
            <TextBlock Text="Inversion:" Margin="0,8,0,0" />
            <TextBox x:Name="InversionText" />
            <TextBlock Text="Pitch Classes (comma):" Margin="0,8,0,0" />
            <TextBox x:Name="PcsText" />
            <TextBlock Text="Styles (comma):" Margin="0,8,0,0" />
            <TextBox x:Name="StylesText" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save" Width="90" Margin="4" Click="Save_Click" />
            <Button Content="Cancel" Width="90" Margin="4" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>